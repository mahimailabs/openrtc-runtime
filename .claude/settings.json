{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(uv run mypy *)",
      "Bash(uv run openrtc list *)",
      "Bash(make test)",
      "Bash(make test-fast)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make typecheck)",
      "Bash(make ci)",
      "Bash(make dev)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "mcp__livekit-docs"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "enabledMcpjsonServers": ["livekit-docs"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || { cd \"$CLAUDE_PROJECT_DIR\" && uv sync --group dev --quiet; }",
            "timeout": 300,
            "statusMessage": "Syncing dev environment (uv)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet ruff format --quiet \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
