---
import { Code } from 'astro:components';
import InstallCommand from '../../../shared/InstallCommand.astro';
import Layout from '../components/Layout.astro';
import RouteDiagram from '../components/RouteDiagram.astro';
import TopConsole from '../components/TopConsole.astro';
import { DOCS, REPO, fetchStars } from '../lib/links';

const stars = await fetchStars();

const before = `# livekit-agents: one entrypoint, so the dispatch is yours
def prewarm(proc: JobProcess):
    proc.userdata["vad"] = silero.VAD.load()

async def entrypoint(ctx: JobContext):
    meta = json.loads(ctx.job.metadata or "{}")
    name = meta.get("agent") or ctx.room.name.split("-")[0]
    agent = {"booking": BookingAgent,
             "support": SupportAgent}[name]()
    session = AgentSession(stt=..., llm=..., tts=...,
                           vad=ctx.proc.userdata["vad"])
    await session.start(agent=agent, room=ctx.room)

cli.run_app(WorkerOptions(entrypoint_fnc=entrypoint,
                          prewarm_fnc=prewarm))`;

const after = `# OpenRTC: register and run
pool = AgentPool(
    default_stt=...,
    default_llm=...,
    default_tts=...,
)
pool.add("booking", BookingAgent)
pool.add("support", SupportAgent)
pool.run()`;

const features = [
  { name: 'Routing', does: 'Metadata or room name picks the agent.', limit: 'An unknown name raises, never falls back.' },
  { name: 'Hot reload', does: 'Save, and live calls run the new code next turn.', limit: 'A bad save keeps the old code.' },
  { name: 'openrtc top', does: 'Every call live, and which one is blocking.', limit: 'Same host; memory is a shared figure.' },
  { name: 'Tenants', does: 'Per-tenant keys, caps and a circuit breaker.', limit: 'One process, not a sandbox.' },
  { name: 'Deploys', does: 'Version tags, drain and audit events.', limit: 'Calls finish on the old version.' },
];

const bench = [
  { label: 'Memory per call', unit: 'MB PSS', max: 70, rows: [
    { who: 'livekit-agents', value: 63 },
    { who: 'OpenRTC', value: 22 },
  ] },
  { label: 'CPU at 8 calls', unit: '% of 2 cores', max: 200, rows: [
    { who: 'livekit-agents', value: 103 },
    { who: 'OpenRTC', value: 130 },
  ] },
];
---

<Layout
  title="OpenRTC · Every LiveKit agent, one worker you can see into"
  description="Run your livekit-agents classes from one pool, see every call live in openrtc top, and hot-reload agent code without dropping the conversation. Open source, MIT."
  path="/"
  stars={stars}
>
  <section class="hero shell">
    <div class="hero__head">
      <h1>Run every LiveKit agent. See every call.</h1>
      <div class="hero__side">
        <p class="hero__lede">
          One pool for your livekit-agents classes, a live view of every call, and hot reload that keeps the
          conversation.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={REPO} rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
            </svg>
            Star on GitHub
            {stars !== null && <span class="btn__count mono">{stars.toLocaleString('en-US')}</span>}
          </a>
          <a class="btn" href={`${DOCS}/`}>Read the docs</a>
        </div>
        <InstallCommand />
      </div>
    </div>
    <TopConsole />
  </section>

  <section class="chapter shell">
    <div class="head">
      <h2>One worker, every agent.</h2>
      <p>Each call is routed to one of your agents: by dispatch metadata, room metadata, or the room's name.</p>
    </div>
    <RouteDiagram />
  </section>

  <section class="chapter shell">
    <div class="head">
      <h2>Your agents stay yours.</h2>
      <p>
        Agents stay standard <code>livekit.agents.Agent</code> subclasses. No base class, and nothing wraps
        <code>@function_tool</code>, <code>RunContext</code> or the node hooks. What goes is the dispatch and session wiring
        you wrote around them.
      </p>
    </div>
    <div class="compare">
      <div class="compare__pane">
        <p class="compare__label">Before</p>
        <Code code={before} lang="python" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
      </div>
      <div class="compare__pane">
        <p class="compare__label">After</p>
        <Code code={after} lang="python" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
      </div>
    </div>
  </section>

  <section class="chapter shell">
    <div class="head">
      <h2>What you get, and its limit.</h2>
    </div>
    <dl class="features">
      {
        features.map((f) => (
          <div class="features__row">
            <dt>{f.name}</dt>
            <dd>{f.does}</dd>
            <dd class="features__limit">{f.limit}</dd>
          </div>
        ))
      }
    </dl>
    <p class="chapter__more"><a class="link" href={`${DOCS}/how-it-works/`}>How each of these works</a></p>
  </section>

  <section class="chapter shell bench">
    <div class="head">
      <h2>Less memory per call. Not more calls per box.</h2>
      <p>
        We measured OpenRTC against livekit-agents 1.8.3 on the same two cores, with a full voice pipeline. OpenRTC's calls
        share one process and use about a third of the memory. They also use more CPU, and CPU runs out first, so run one
        worker per core. When it is saturated the worker stops taking calls: offered 24, it took 12, and all 12
        answered.
      </p>
      <a class="link" href={`${DOCS}/benchmark/`}>The method, and what it does not cover</a>
    </div>
    <div class="bench__charts">
      {
        bench.map((b) => (
          <figure class="bars">
            <figcaption>
              {b.label} <span>{b.unit}</span>
            </figcaption>
            {b.rows.map((r) => (
              <div class="bars__row" data-who={r.who}>
                <span class="bars__who">{r.who}</span>
                <span class="bars__track">
                  <span class="bars__fill" style={`width: ${(r.value / b.max) * 100}%`} />
                </span>
                <span class="bars__value mono">~{r.value}</span>
              </div>
            ))}
          </figure>
        ))
      }
    </div>
  </section>

  <section class="chapter shell close">
    <h2>Early, open, and MIT.</h2>
    <p>
      OpenRTC is early and has few users so far. Star the repository to follow it, or point it at your own agents: the
      quick start takes a few minutes.
    </p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href={REPO} rel="noopener">Star on GitHub</a>
      <a class="btn" href={`${DOCS}/#quick-start`}>Quick start</a>
    </div>
  </section>
</Layout>
