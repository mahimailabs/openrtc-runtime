---
import '../styles/landing.css';
import Mark from '../../../shared/Mark.astro';
import ThemeScript from '../../../shared/ThemeScript.astro';
import ThemeToggle from '../../../shared/ThemeToggle.astro';
import { DOCS, PYPI, REPO } from '../lib/links';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Live GitHub star count, fetched at build time; null when the fetch failed. */
  stars: number | null;
}
const { title, description, path, stars } = Astro.props;
const canonical = new URL(path, Astro.site!).href;
const nav = [
  { href: `${DOCS}/`, label: 'Docs' },
  { href: `${DOCS}/how-it-works/`, label: 'How it works' },
  { href: `${DOCS}/benchmark/`, label: 'Benchmark' },
  { href: `${DOCS}/changelog/`, label: 'Changelog' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenRTC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <ThemeScript />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="shell top__row">
        <a class="brand" href="/">
          <Mark />
          <span>OpenRTC</span>
        </a>
        <nav class="top__nav" aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="top__tools">
          <a class="gh" href={REPO} rel="noopener">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span class="gh__label">GitHub</span>
            {stars !== null && <span class="gh__stars mono">{stars.toLocaleString('en-US')}</span>}
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="shell foot__row">
        <p class="foot__brand"><Mark /> OpenRTC</p>
        <ul class="foot__links">
          <li><a href={`${DOCS}/`}>Docs</a></li>
          <li><a href={REPO} rel="noopener">GitHub</a></li>
          <li><a href={PYPI} rel="noopener">PyPI</a></li>
          <li><a href={`${DOCS}/changelog/`}>Changelog</a></li>
          <li><a href={`${REPO}/blob/main/LICENSE`} rel="noopener">MIT</a></li>
          <li>Made by <a href="https://mahimai.ca" rel="noopener">Mahimai</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
