---
// The OpenRTC mark: four agents in one frame, one of them live.
---

<svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
  <rect class="mark__frame" x="2" y="2" width="20" height="20" rx="5"></rect>
  <circle class="mark__dot mark__dot--live" cx="9" cy="9" r="2.3"></circle>
  <circle class="mark__dot" cx="15" cy="9" r="2.3"></circle>
  <circle class="mark__dot" cx="9" cy="15" r="2.3"></circle>
  <circle class="mark__dot" cx="15" cy="15" r="2.3"></circle>
</svg>
