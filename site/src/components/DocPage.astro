---
// One page rendered from a file in ../docs, so the text has one source. The home page passes a
// `hero` slot that replaces the plain title block.
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import { mdxComponents } from './mdx';
import { PAGES, REPO } from '../lib/site';

interface Props {
  doc: {
    frontmatter: { title: string; description?: string };
    Content: any;
    getHeadings: () => MarkdownHeading[];
  };
  path: string;
  /** <title>; defaults to "<page title> · OpenRTC". */
  title?: string;
}
const { doc, path } = Astro.props;
const { title, description = '' } = doc.frontmatter;
const page = PAGES.find((p) => p.href === path)!;
const index = PAGES.indexOf(page);
const prev = PAGES[index - 1];
const next = PAGES[index + 1];
const headings = doc.getHeadings().filter((h) => h.depth === 2 || h.depth === 3);
const hasHero = Astro.slots.has('hero');
---

<Layout title={Astro.props.title ?? `${title} · OpenRTC`} description={description} path={path}>
  {hasHero && <slot name="hero" />}
  <div class="shell doc">
    <article>
      {
        !hasHero && (
          <header class="page__head">
            <h1>{title}</h1>
            {description && <p class="page__lede">{description}</p>}
          </header>
        )
      }
      <div class="mdx prose">
        <doc.Content components={mdxComponents} />
      </div>
      <nav class="pager" aria-label="Pages">
        {
          prev && (
            <a href={prev.href} rel="prev">
              <span>Previous</span>
              <strong>{prev.label}</strong>
            </a>
          )
        }
        {
          next && (
            <a class="pager__next" href={next.href} rel="next">
              <span>Next</span>
              <strong>{next.label}</strong>
            </a>
          )
        }
      </nav>
      <p class="edit">
        <a class="link" href={`${REPO}/blob/main/docs/${page.file}`} rel="noopener">Edit this page on GitHub</a>
      </p>
    </article>
    {
      headings.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc__title">On this page</p>
          <ol>
            {headings.map((h) => (
              <li data-depth={h.depth}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</Layout>

<script is:inline>
  // Label each table cell with its column header, so tables stack into labelled rows on phones.
  document.querySelectorAll('.mdx table').forEach(function (table) {
    var labels = Array.prototype.map.call(table.querySelectorAll('thead th'), function (th) {
      return th.textContent.trim();
    });
    table.querySelectorAll('tbody tr').forEach(function (row) {
      Array.prototype.forEach.call(row.children, function (cell, i) {
        if (labels[i]) cell.setAttribute('data-label', labels[i]);
      });
    });
  });
  // Mark the section being read in the contents rail.
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('.toc a'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    function mark(id) {
      links.forEach(function (a) {
        a.setAttribute('aria-current', String(a.hash === '#' + id));
      });
    }
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) mark(e.target.id);
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    links.forEach(function (a) {
      var target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (target) observer.observe(target);
    });
  })();
</script>
